EventTicket_Text_ShowOldSeaMap:
	.string "Le ferry allant à POIVRESSEL\n"
	.string "est…\p"
	.string "Pardon? Est-ce que nous pouvons\n"
	.string "aller à cet endroit indiqué sur\p"
	.string "la carte?\p"
	.string "Je connais quelqu’un qui pourra\n"
	.string "t’aider. Un instant.$"

EventTicket_Text_ThatPass:
	.string "Le ferry allant à POIVRESSEL\n"
	.string "est…\p"
	.string "Oh? Ce PASSE…$"

EventTicket_Text_ShowEonTicket:
	.string "Hé, mon p’tit, c’est toi qui as\n"
	.string "apporté ce drôle de PASSE?\p"
	.string "J’vais t’dire, tu te diriges\n"
	.string "vers une île minuscule beaucoup\p"
	.string "plus au sud.\p"
	.string "Impossible de dire ce qui\n"
	.string "t’attend là-bas, mon p’tit.\p"
	.string "Ça me donne la chair de poule!\p"
	.string "Tout le monde à bord!$"

#if IS_HNS
EventTicket_Text_SouthernIslandSailBack:
	.string "Dis, mon p’tit, y a absolument rien à voir\n"
	.string "sur cette île perdue.\p"
	.string "On retourne à OLIVILLE?$"
#else
EventTicket_Text_SouthernIslandSailBack:
	.string "Dis, mon p’tit, y a absolument\n"
	.string "rien à voir sur cette île\p"
	.string "perdue.\p"
	.string "On retourne à NENUCRIQUE?$"
#endif 


EventTicket_Text_SailHome:
	.string "C’est d’accord, mon p’tit! On\n"
	.string "est partis!$"

EventTicket_Text_AsYouLike:
	.string "D’accord, mon p’tit, comme tu\n"
	.string "veux.$"

SouthernIsland_Interior_Text_Sign:
	.string "“Les rêves ne sont qu’une autre\n"
	.string "réalité. Ne jamais l’oublier…”$"

SouthernIsland_Exterior_Text_Sign:
	.string "“Ceux dont les souvenirs\n"
	.string "s’estompent cherchent à les\p"
	.string "graver dans leur cœur.”$"
