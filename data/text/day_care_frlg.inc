@ Same as Hoenn's day-care text, used by the Four Island Day-Care. Unused text translated in Emerald

DayCare_Text_ImDaycareManSpeakToMyWife::
	.string "Je suis l'HOTE DE LA PENSION.\p"
	.string "Je m'occupe des précieux POKéMON\n"
	.string "des DRESSEURS.\p"
	.string "Si tu veux que je m'occupe d'un\n"
	.string "de tes POKéMON, va parler à ma\p"
	.string "femme.$"

DayCare_Text_DoYouWantEgg::
	.string "Ah, c'est toi!\p"
	.string "Nous nous occupions de ton\n"
	.string "POKéMON et nous avons eu une\p"
	.string "énorme surprise!\p"
	.string "Ton POKéMON a eu un OEUF!\p"
	.string "On ne sait pas comment il est\n"
	.string "arrivé là, mais ton POKéMON\p"
	.string "l'avait.\p"
	.string "Tu le veux?$"

DayCare_Text_YourMonIsDoingFine::
	.string "Ah, c'est toi! Content de te\n"
	.string "voir. Ton {STR_VAR_1} se porte\p"
	.string "très bien.$"

DayCare_Text_IllKeepIt::
	.string "Bien, dans ce cas, je vais le\n"
	.string "garder. Merci!$"

DayCare_Text_YouHaveNoRoomForIt::
	.string "Ton équipe est complète… Reviens\n"
	.string "quand tu auras fait de la place.$"

DayCare_Text_ReceivedEgg::
	.string "{PLAYER} reçoit l'OEUF de la\n"
	.string "part de l'HOTE DE LA PENSION.$"

DayCare_Text_TakeGoodCareOfIt::
	.string "Prends-en bien soin.$"

DayCare_Text_SeeWifeIfYouWantToPickUpMon::
	.string "ポケモンを　ひきとりたい　ときは ばさんに　いって　おくれ$"

DayCare_Text_YourMonsAreDoingFine::
	.string "Ah, c'est toi! Ton {STR_VAR_1}\n"
	.string "et ton {STR_VAR_2} se portent\p"
	.string "très bien.$"

DayCare_Text_IWillKeepDoYouWantIt::
	.string "Je vais vraiment le garder. Tu\n"
	.string "le veux, ou pas?$"

DayCare_Text_WouldYouLikeUsToRaiseMon::
	.string "Je suis l'HOTESSE DE LA PENSION.\p"
	.string "Nous pouvons élever des POKéMON\n"
	.string "pour toi.\p"
	.string "Tu veux qu'on en élève un?$"

DayCare_Text_WhichMonShouldWeRaise::
	.string "Quel POKéMON veux-tu que l'on\n"
	.string "élève?$"

DayCare_Text_WellRaiseYourMon::
	.string "Très bien, nous allons nous\n"
	.string "occuper de ton {STR_VAR_1}\p"
	.string "pendant un moment.\p"
	.string "Reviens le chercher plus tard.$"

DayCare_Text_WeCanRaiseOneMore::
	.string "Nous pouvons élever deux\n"
	.string "POKéMON. Tu veux qu'on en élève\p"
	.string "un autre?$"

DayCare_Text_HusbandWasLookingForYou::
	.string "Mon mari te cherchait.$"

DayCare_Text_FineThenComeAgain::
	.string "Oh, très bien. Reviens plus\n"
	.string "tard, dans ce cas.$"

DayCare_Text_NotEnoughMoney::
	.string "Tu n'as pas assez d'argent…$"

DayCare_Text_TakeOtherOneBackToo::
	.string "Veux-tu aussi reprendre le\n"
	.string "deuxième?$"

DayCare_Text_ComeAgain::
	.string "Très bien. Reviens plus tard.$"

DayCare_Text_GoodToSeeYou::
	.string "Ah, c'est toi! Contente de te\n"
	.string "voir. Ton POKéMON est sûr d'être\p"
	.string "bien traité!$"

DayCare_Text_YourMonHasGrownXLevels::
	.string "Ton {STR_VAR_1} est monté de\n"
	.string "{STR_VAR_2} niveau(x).$"

DayCare_Text_YourPartyIsFull::
	.string "Ton équipe de POKéMON est au\n"
	.string "complet. Fais de la place et\p"
	.string "reviens me voir.$"

DayCare_Text_TakeBackWhichMon::
	.string "どっちの　ポケモンを　ひきとるかい？$"

DayCare_Text_ItWillCostX::
	.string "Si tu veux récupérer ton\n"
	.string "{STR_VAR_1}, tu dois payer\p"
	.string "{STR_VAR_2}¥.$"

DayCare_Text_HeresYourMon::
	.string "Parfait! Voilà ton POKéMON.$"

DayCare_Text_TookBackMon::
	.string "{PLAYER} reprend le {STR_VAR_1}\n"
	.string "à l'HOTESSE DE LA PENSION.$"

DayCare_Text_YouHaveJustOneMon::
	.string "Oh! Mais tu n'as qu'un seul\n"
	.string "POKéMON.\p"
	.string "Reviens une autre fois.$"

DayCare_Text_TakeYourMonBack::
	.string "Veux-tu reprendre ton POKéMON?$"

DayCare_Text_WhatWillYouBattleWith::
	.string "Si tu me laisses ce POKéMON,\n"
	.string "comment vas-tu faire pour te\p"
	.string "battre?\p"
	.string "Reviens me voir une autre fois.$"

DayCare_Text_Huh::
	.string "Hein?$"
