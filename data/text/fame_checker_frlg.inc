PokemonJournal_Text_SpecialFeatureBrock::
	.string "JOURNAL POKéMON\p"
	.string "Avec PIERRE, le CHAMPION d'ARENE\n"
	.string "d'ARGENTA!\p"
	.string "PIERRE rigole rarement, mais il\n"
	.string "ne peut pas s'arrêter s'il\p"
	.string "commence.$"

PokemonJournal_Text_SpecialFeatureMisty::
	.string "JOURNAL POKéMON\p"
	.string "Avec ONDINE, le CHAMPION d'ARENE\n"
	.string "d'AZURIA!\p"
	.string "On raconte qu'elle adore OLGA du\n"
	.string "CONSEIL 4.$"

PokemonJournal_Text_SpecialFeatureLtSurge::
	.string "JOURNAL POKéMON\p"
	.string "Avec MAJOR BOB, le CHAMPION\n"
	.string "d'ARENE de CARMIN SUR MER!\p"
	.string "Il aurait été pilote quand il\n"
	.string "était dans l'armée.\p"
	.string "Il utilisait l'électricité\n"
	.string "générée par ses POKéMON pour\p"
	.string "faire\p"
	.string "voler son avion.$"

PokemonJournal_Text_SpecialFeatureErika::
	.string "JOURNAL POKéMON\p"
	.string "Avec ERIKA, le CHAMPION d'ARENE\n"
	.string "de CELADOPOLE!\p"
	.string "Si vous arrivez sans prévenir à\n"
	.string "l'ARENE de CELADOPOLE,\p"
	.string "vous risquez de la voir en train\n"
