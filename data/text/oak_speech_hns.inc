gText_Oak_Welcome::
	.string "Bonjour! Désolé de l'attente!\p"
	.string "Bienvenue dans le monde des\n"
	.string "POKéMON!\p"
	.string "Mon nom est CHEN.\p"
	.string "Mais on m'appelle le\n"
	.string "PROF. POKéMON.\p"
	.string "$"

gText_Oak_Pokemon::
	.string "Cette créature est ce que nous\n"
	.string "appelons un “POKéMON”.\p"
	.string "\n"
	.string "$"

gText_Oak_MainSpeech::
	.string "Ce monde est peuplé de créatures\n"
	.string "appelées POKéMON.\p"
	.string "Humains et POKéMON vivent\n"
	.string "ensemble en parfaite harmonie.\p"
	.string "Certains jouent avec les POKéMON,\n"
	.string "d'autres combattent à leurs côtés.\p"
	.string "Mais il reste beaucoup à apprendre\n"
	.string "sur nos amis les POKéMON.\p"
	.string "De nombreux mystères planent\n"
	.string "encore à leur sujet.\p"
	.string "Et c'est pourquoi j'étudie les\n"
	.string "POKéMON tous les jours.\p"
	.string "$"

gText_Oak_AndYouAre::
	.string "Et toi, qui es-tu?$"

gText_Oak_BoyOrGirl::
	.string "Es-tu un garçon?\n"
	.string "Ou es-tu une fille?$"

gText_Oak_WhatChallenge::
	.string "Quel niveau de difficulté\n"
	.string "souhaites-tu relever?$"

gText_Oak_ChallengeSelected::
	.string "Ce niveau de difficulté me\n"
	.string "semble tout indiqué pour toi!$"

gText_Oak_WhatsYourName::
	.string "Heu... C'est quoi ton nom?$"

gText_Oak_SoItsPlayer::
	.string "Ah! Alors tu t'appelles\n"
	.string "{PLAYER}{KUN}?$"

gText_Oak_YourePlayer::
	.string "{PLAYER}{KUN}, es-tu prêt?\p"
	.string "Ta propre aventure est sur le\n"
	.string "point de commencer.\p"
	.string "$"

gText_Oak_AreYouReady::
	.string "Joies et périls paveront ta\n"
	.string "route.\p"
	.string "Un monde de rêves et d'aventures\n"
	.string "avec les POKéMON t'attend!\p"
	.string "En avant!\p"
	.string "À plus tard!\p"
	.string "$"
