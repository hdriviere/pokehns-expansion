FallarborTown_BattleTentLobby_Text_ExplainFallarborTent:
#if IS_HNS
	.string "Dans la TENTE DE COMBAT ARENE,\n"
#else
	.string "Dans la TENTE DE COMBAT d'AUTEQUIA,\n"
#endif
	.string "nous organisons le TOURNOI K.O.\p"
	.string "Chaque participant présente une\n"
	.string "équipe de trois POKéMON.\p"
	.string "Ces trois POKéMON doivent être\n"
	.string "rangés dans leur ordre d'entrée.\p"
	.string "Pendant le combat, ils apparaissent\n"
	.string "un à un, dans l'ordre choisi.\p"
	.string "Une fois entré, un POKéMON reste\n"
	.string "jusqu'à ce que le duel soit décidé.\p"
	.string "Si le duel reste indécis après trois\n"
	.string "tours, il passe devant le jury.\p"
	.string "Pour interrompre votre défi, vous\n"
	.string "devez sauvegarder la partie.\p"
	.string "Sans sauvegarde, vous ne pourrez\n"
	.string "pas reprendre votre défi.\p"
	.string "Si vous battez trois DRESSEURS de\n"
	.string "suite, nous vous offrirons un beau\p"
	.string "prix.$"

