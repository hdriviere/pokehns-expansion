BerryBlender_Text_BlendWithTheBlendMaster:
	.string "MAITRE MIXEUR: C’est moi! Je\n"
	.string "suis le MAITRE MIXEUR!\p"
	.string "Mixe avec moi et tu verras le\n"
	.string "maître à l’œuvre!$"

BerryBlender_Text_SeeMyMasteryInAction:
	.string "MAITRE MIXEUR: Hum! Alors comme\n"
	.string "ça, tu veux voir le maître à\p"
	.string "l’œuvre?$"

BerryBlender_Text_TooBusyNowIsee:
	.string "Hum!\p"
	.string "Tu n’as pas le temps, je vois!\p"
	.string "Mais ne crains rien! Je ne bouge\n"
	.string "pas d’ici aujourd’hui! Reviens\p"
	.string "vite!$"

BerryBlender_Text_BlendMasterNoBerries:
	.string "Hum!\p"
	.string "Tu n’as pas une seule BAIE!\p"
	.string "Je ne bouge pas d’ici\n"
	.string "aujourd’hui! Reviens vite!$"

BerryBlender_Text_BlendMasterKnowHowToMakePokeblocks:
	.string "Bien sûr! Bien sûr!\p"
	.string "Au fait… Tu sais comment mixer\n"
	.string "des BAIES pour faire des\p"
	.string "{POKEBLOCK}S?$"

BerryBlender_Text_BlendMasterExplainBerryBlending:
	.string "Hum!\p"
	.string "C’est simple comme bonjour!\p"
	.string "Lorsque la flèche du MIXEUR\n"
	.string "passe devant ton marqueur,\p"
	.string "appuie simplement sur le bouton\n"
	.string "A.\p"
	.string "C’est tout.\p"
	.string "Quand tu me verras appuyer sur\n"
	.string "le bouton A, tu comprendras\p"
	.string "comme c’est facile.$"

BerryBlender_Text_BlendMasterLetsBerryBlender:
	.string "Bien!\p"
	.string "Dans ce cas, allons-y!\p"
	.string "C’est parti pour le MIXEUR, avec\n"
	.string "le MAITRE MIXEUR!$"

BerryBlender_Text_BlendMasterNoPokeblockCase:
	.string "Hum!\p"
	.string "On dirait que tu n’as pas encore\n"
	.string "de BOITE {POKEBLOCK}S!\p"
	.string "Je ne bouge pas d’ici\n"
	.string "aujourd’hui! Trouve vite une\p"
	.string "BOITE {POKEBLOCK}S!$"

BerryBlender_Text_BlendMasterPokeblockCaseFull:
	.string "Hum!\p"
	.string "Ta BOITE {POKEBLOCK}S est\n"
	.string "pleine!\p"
	.string "Je ne bouge pas d’ici\n"
	.string "aujourd’hui! Utilise quelques\p"
	.string "{POKEBLOCK}S et reviens!$"

BerryBlender_Text_WhoaAwesome:
	.string "Waouh! Joli!$"

BerryBlender_Text_WickedlyFast:
	.string "Super rapide!$"

BerryBlender_Text_WhatAnExpert:
	.string "Formidable!$"

BerryBlender_Text_MadeAmazingPokeblocksWithMaster:
	.string "J’ai mixé avec le MAITRE MIXEUR\n"
	.string "et on a fait de superbes\p"
	.string "{POKEBLOCK}S!$"

BerryBlender_Text_QualitiesOfBlendMaster:
	.string "Des yeux de lynx qui suivent la\n"
	.string "flèche au centième de millimètre\p"
	.string "près…\p"
	.string "Une main qui appuie sur le\n"
	.string "bouton A avec la précision d’un\p"
	.string "métronome…\p"
	.string "C’est ça qui fait le succès du\n"
	.string "MAITRE MIXEUR.$"

BerryBlender_Text_MasterWorksOnSkillsInMountains:
	.string "Le MAITRE MIXEUR passe tout son\n"
	.string "temps à s’entraîner dans la\p"
	.string "montagne.\p"
	.string "Parfois, il nous fait l’honneur\n"
	.string "de venir à NENUCRIQUE pour y\p"
	.string "mixer des BAIES.$"
