PokemonLeague_ChampionsRoom_EventScript_AdjustPlayerFacingEast::
	applymovement OBJ_EVENT_ID_PLAYER, PokemonLeague_ChampionsRoom_Movement_AdjustPlayerFacingEast
	waitmovement 0
	return
PokemonLeague_ChampionsRoom_EventScript_AdjustPlayerFacingSouth::
	applymovement OBJ_EVENT_ID_PLAYER, PokemonLeague_ChampionsRoom_Movement_AdjustPlayerFacingSouth
	waitmovement 0
	return
PokemonLeague_ChampionsRoom_EventScript_AdjustPlayerFacingWest::
	applymovement OBJ_EVENT_ID_PLAYER, PokemonLeague_ChampionsRoom_Movement_AdjustPlayerFacingWest
	waitmovement 0
	return

PokemonLeague_ChampionsRoom_Movement_AdjustPlayerFacingEast:
	walk_down
	walk_right
	face_up
	step_end
PokemonLeague_ChampionsRoom_Movement_AdjustPlayerFacingSouth:
	walk_left
	walk_down
	walk_down
	walk_right
	face_up
	step_end
PokemonLeague_ChampionsRoom_Movement_AdjustPlayerFacingWest:
	walk_down
	walk_left
	face_up
	step_end

PokemonLeague_ChampionsRoom_Movement_PlayerMoveToCenter:
	lock_facing_direction
	walk_up
	unlock_facing_direction
	step_end

PokemonLeague_ChampionsRoom_Movement_LanceMoveOver:
	lock_facing_direction
	walk_right
	unlock_facing_direction
	step_end

PokemonLeague_ChampionsRoom_Movement_MaryEnter:
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	delay_2
	walk_in_place_fast_down
	step_end

PokemonLeague_ChampionsRoom_Movement_MaryMoveOver:
	walk_left
	face_right
	step_end

PokemonLeague_ChampionsRoom_Movement_OakEnter:
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	step_end

PokemonLeague_ChampionsRoom_Movement_MaryInterview:
	walk_fast_up
	walk_in_place_fast_right
	step_end

PokemonLeague_ChampionsRoom_Movement_LanceAnxious:
	face_up
	delay_16
	delay_16
	face_down
	delay_16
	delay_16
	face_left
	step_end

PokemonLeague_ChampionsRoom_Movement_LanceLeave:
	walk_up
	walk_left
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	step_end

PokemonLeague_ChampionsRoom_Movement_PlayerLeave:
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	walk_up
	step_end

PokemonLeague_ChampionsRoom_Movement_MaryLeft:
	walk_fast_right
	walk_fast_up
	walk_fast_up
	walk_fast_up
	walk_fast_up
	step_end

PokemonLeague_ChampionsRoom_Text_RematchBattleIntro:
    .string "PETER: Bon retour!\p"
    .string "Tu as fait tes preuves à JOHTO,\p"
    .string "obtenu les 8 Badges et tu m'as\n"
    .string "même déjà vaincu.\p"
    .string "Mais à présent, tu entres dans\n"
    .string "la cour des grands.\p"
    .string "La LIGUE de KANTO!\p"
    .string "Une région avec ses propres\n"
    .string "épreuves et ses Champions.\p"
    .string "Ici, je suis l'ultime défi, avec\n"
    .string "une équipe plus forte que\l"
    .string "jamais.\p"
    .string "Voici la véritable épreuve:\p"
    .string "un combat qui désignera le\n"
    .string "MAÎTRE de KANTO.\p"
    .string "Es-tu prêt à relever ce nouveau\n"
    .string "défi?\p"
    .string "À faire encore tes preuves?\p"
    .string "Montre-moi la force qui t'a\n"
    .string "permis de conquérir JOHTO,\l"
    .string "MAÎTRE.$"

PokemonLeague_ChampionsRoom_Text_BattleIntro:
    .string "Peter: Je t’attendais!\p"
    .string "{PLAYER}!\p"
    .string "Je savais que tu allais finir\n"
    .string "par arriver jusqu’ici.\p"
    .string "Bon. Assez parlé!\p"
    .string "Nous allons juste\n"
    .string "nous battre pour\p"
    .string "savoir qui est\n"
    .string "le plus fort.\p"
    .string "Je suis le Dresseur le plus\n"
    .string "puissant! Le Maître de la Ligue!\p"
    .string "L’expert Dracologue! En garde!$"

PokemonLeague_ChampionsRoom_Text_BattleWin:
    .string "... C’est fini.\p"
    .string "Je me sens... bizarre...\p"
    .string "Je ne suis pas\n"
    .string "fâché mais... plutôt\p"
    .string "heureux. Heureux\n"
    .string "d’être le témoin de la\p"
    .string "naissance d’un nouveau Maître!$"

PokemonLeague_ChampionsRoom_Text_BattleAfter:
    .string "... Eh bien...\p"
    .string "Tu as bien progressé, {PLAYER}.\p"
    .string "Toi et ton équipe êtes en\n"
    .string "parfaite harmonie.\p"
    .string "Je suis sûr que vous continuerez\n"
    .string "à progresser encore...$"

PokemonLeague_ChampionsRoom_Text_MaryOhNoOak:
    .string "LULA: Oh, non! C'est fini! PROF.\p"
    .string "CHEN, vous êtes trop lent...$"

PokemonLeague_ChampionsRoom_Text_OakCongratulations:
    .string "CHEN: Ah, {PLAYER}!\p"
    .string "Ça faisait bien longtemps.\p"
    .string "Tu as changé, ma parole!\p"
    .string "Ta victoire sur la LIGUE de\n"
    .string "JOHTO est, ma foi,\l"
    .string "impressionnante!\p"
    .string "Ton amour et ton dévouement\n"
    .string "t'ont mené jusque-là.\p"
    .string "Ton équipe Pokémon a aussi fait\n"
    .string "du beau boulot.\p"
    .string "Tu es reconnu comme étant un\n"
    .string "être et un Dresseur d'exception.\p"
    .string "Encore bravo, {PLAYER}!$"

PokemonLeague_ChampionsRoom_Text_RematchOakCongratulations:
    .string "CHEN: Ah, {PLAYER}!\p"
    .string "Je suis tes progrès depuis que\n"
    .string "le PROF. ORME t'a confié cette\l"
    .string "mission.\p"
    .string "Tu es devenu encore plus\n"
    .string "impressionnant.\p"
    .string "Conquérir les LIGUES de JOHTO\n"
    .string "puis de KANTO n'est pas rien.\p"
    .string "Tu t'es vraiment surpassé!\p"
    .string "Tes Pokémon ont manifestement\n"
    .string "une immense confiance en toi,\p"
    .string "et cette confiance a fondé ta\n"
    .string "réussite.\p"
    .string "Mais souviens-toi: le voyage\n"
    .string "d'un Dresseur ne s'achève\l"
    .string "jamais.\p"
    .string "Félicitations pour ta victoire,\n"
    .string "{PLAYER}!$"

PokemonLeague_ChampionsRoom_Text_MaryInterview:
    .string "LULA: Faisons une interview du\n"
    .string "nouveau MAÎTRE de JOHTO!$"

PokemonLeague_ChampionsRoom_Text_RematchMaryInterview:
    .string "LULA: Faisons une interview du\n"
    .string "nouveau MAÎTRE de KANTO!$"

PokemonLeague_ChampionsRoom_Text_Noisy:
    .string "Peter: Eh bien, quelle animation\n"
    .string "tout d’un coup...\p"
    .string "{PLAYER}! Suis-moi!$"

PokemonLeague_ChampionsRoom_Text_MaryNoInterview:
    .string "Lula: Eh! Et mon interview!$"

PokemonLeague_ChampionsRoom_Text_RematchMaryNoInterview:
    .string "LULA: Allons! Tu ne vas pas\n"
    .string "ENCORE esquiver l'interview!$"
