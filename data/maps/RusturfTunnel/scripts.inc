RusturfTunnel_EventScript_Mike::
	trainerbattle_single TRAINER_MIKE_2, RusturfTunnel_Text_MikeIntro, RusturfTunnel_Text_MikeDefeat
	msgbox RusturfTunnel_Text_MikePostBattle, MSGBOX_AUTOCLOSE
	end

RusturfTunnel_Text_ComeAndGetSome:
	.string "Alors, tu me suis?$"

RusturfTunnel_Text_Peeko:
	.string "PIKO: Pii pikooo!$"

RusturfTunnel_Text_GruntIntro:
	.string "C’est pas possible…\p"
	.string "Ce POKéMON pris en otage ne me\n"
	.string "sert à rien!\p"
	.string "Et quand je pense que je me suis\n"
	.string "enfui par ce tunnel qui ne mène\p"
	.string "nulle part!\p"
	.string "Hé! Toi! Alors, tu veux te\n"
	.string "battre contre moi?$"

RusturfTunnel_Text_GruntDefeat:
	.string "Arrrg! Ma carrière de criminel\n"
	.string "finit mal!$"

RusturfTunnel_Text_GruntTakePackage:
	.string "C’est vraiment pas juste…\p"
	.string "Le CHEF m’avait dit que ce\n"
	.string "serait simple comme bonjour.\p"
	.string "Tout ce que j’avais à faire,\n"
	.string "c’était de voler un paquet chez\p"
	.string "DEVON.\p"
	.string "Pff! Si tu l’veux vraiment, t’as\n"
	.string "qu’à l’prendre!$"

RusturfTunnel_Text_PeekoGladToSeeYouSafe:
	.string "PIKO! Tu es sauf! Quelle joie!$"

RusturfTunnel_Text_ThankYouLetsGoHomePeeko:
	.string "PIKO te doit la vie!\p"
	.string "On m’appelle M. MARCO. Et toi,\n"
	.string "comment t’appelles-tu?\p"
	.string "… … … … … … … … … … … … … … … …\p"
	.string "Ah, alors tu es {PLAYER}{KUN}!\n"
	.string "Je te remercie infiniment!\p"
	.string "Désormais, s’il y a quoi que ce\n"
	.string "soit, n’hésite pas à m’en\p"
	.string "parler!\p"
	.string "Tu peux me trouver dans ma\n"
	.string "maison en bord de mer près du\p"
	.string "BOIS CLEMENTI.\p"
	.string "Allez, viens PIKO. On rentre.\p"
	.string "PIKO: Pihikoh!$"

RusturfTunnel_Text_WhyCantTheyKeepDigging:
	.string "… …\p"
	.string "Pourquoi ne peuvent-ils plus\n"
	.string "creuser? La roche est-elle trop\p"
	.string "dure?\p"
	.string "Ma petite amie m’attend à\n"
	.string "VERGAZON, qui se trouve juste\p"
	.string "derrière…\p"
	.string "Si ce tunnel pouvait relier\n"
	.string "MEROUVILLE et VERGAZON, je\p"
	.string "pourrais aller la voir tous les\n"
	.string "jours…\p"
	.string "Mais comme ça… Que faire?$"

RusturfTunnel_Text_ToGetToVerdanturf:
	.string "Pour aller de MEROUVILLE à\n"
	.string "VERGAZON, il faut aller à\p"
	.string "MYOKARA et ensuite passer par\n"
	.string "POIVRESSEL et LAVANDIA…$"

RusturfTunnel_Text_YouShatteredBoulderTakeHM:
	.string "Waouh! Tu as pulvérisé ce bloc\n"
	.string "de pierre qui bouchait le\p"
	.string "passage.\p"
	.string "Pour que tu saches combien\n"
	.string "j’apprécie, j’aimerais que tu\p"
	.string "prennes cette CS.$"

RusturfTunnel_Text_ExplainStrength:
	.string "Cette CS contient FORCE.\p"
	.string "Si un POKéMON musclé l’apprend,\n"
	.string "il sera capable de déplacer de\p"
	.string "gros rochers.$"

RusturfTunnel_Text_WandaReunion:
	.string "SYLVIE! Maintenant, on peut se\n"
	.string "voir quand on veut!\p"
	.string "SYLVIE: C’est… merveilleux.\p"
	.string "Repose-toi un peu chez moi.$"

RusturfTunnel_Text_BoyfriendOnOtherSideOfRock:
	.string "De l’autre côté de ce rocher…\n"
	.string "C’est là que se trouve mon petit\p"
	.string "ami.\p"
	.string "Il… Il ne creuse pas le tunnel\n"
	.string "juste pour me voir.\p"
	.string "S’il travaille dur, c’est pour\n"
	.string "que tout le monde puisse en\p"
	.string "profiter.$"

RusturfTunnel_Text_MikeIntro:
	.string "Comment appelle-t-on un homme\n"
	.string "vivant dans les montagnes?\p"
	.string "Un homme des montagnes? Alors\n"
	.string "pourquoi n’appelle-t-on pas un\p"
	.string "POKéMON vivant dans les\n"
	.string "montagnes un POKéMON des\p"
	.string "montagnes?$"

RusturfTunnel_Text_MikeDefeat:
	.string "Mes POKéMON… n’ont plus de\n"
	.string "pouvoir…$"

RusturfTunnel_Text_MikePostBattle:
	.string "Ici, ils ont interrompu\n"
	.string "l’aménagement pour protéger les\p"
	.string "POKéMON, pas vrai?\p"
	.string "C’est une question de bien-être!$"

